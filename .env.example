# scripts/start.sh generates real credentials in .env. Do not commit .env.
SITE_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters
SECRET_KEY=replace-with-at-least-32-random-characters
INTERNAL_TOKEN=replace-with-at-least-32-random-characters
# Enable after configuring HTTPS on your reverse proxy.
COOKIE_SECURE=false
# Full-site archive limit (100 GiB); separate from the 2 GiB material limit.
MAX_BACKUP_BYTES=107374182400
